# Public CSV export URL for the timetable tab (not the normal /edit URL).
TIMETABLE_CSV_URL=https://docs.google.com/spreadsheets/d/11WB5tFPzh_zB8ssCTx3UzrN2ZRp7hJOwhpHCIguAWaU/export?format=csv&gid=0

# Supabase server credentials. Never prefix the service-role key with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared classroom login and cookie signing secret (32+ random characters each).
CLASSROOM_ACCESS_CODE=replace-with-a-long-private-passphrase
SESSION_SECRET=replace-with-at-least-32-random-characters

# Protects the scheduled endpoint. Vercel sends this automatically when configured.
CRON_SECRET=replace-with-at-least-32-random-characters

# Resend
RESEND_API_KEY=re_your_key
EMAIL_FROM=IBDP Portal <updates@your-verified-domain.com>
EMAIL_TO=you@example.com

# Used for trusted production requests and links in reminder emails.
APP_URL=https://ibdpsrkp.vercel.app

# Timetable date handling
APP_TIME_ZONE=Asia/Kolkata
